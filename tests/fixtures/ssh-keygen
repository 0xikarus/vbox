#!/usr/bin/env bash

# Reproduces `ssh-keygen -f FILE -R HOST` so that host-key recovery can be
# asserted to touch exactly one file and exactly one host.

set -euo pipefail

state_dir="${VMBOX_TEST_STATE:?}"
printf '%q ' "$@" >>"$state_dir/ssh-keygen.log"
printf '\n' >>"$state_dir/ssh-keygen.log"

file=""
host=""
while (($#)); do
  case "$1" in
    -f) file="$2"; shift 2 ;;
    -R) host="$2"; shift 2 ;;
    *) shift ;;
  esac
done
[[ -n "$file" && -n "$host" ]] || exit 64
[[ -f "$file" ]] || exit 1
grep -Fv "$host " "$file" >"$file.tmp" || true
mv -f "$file.tmp" "$file"
: >"$state_dir/host-key-repaired"
printf 'Host %s found: line 1\n' "$host"
