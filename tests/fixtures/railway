#!/usr/bin/env bash

set -euo pipefail

state_dir="${VMBOX_TEST_STATE:?}"
mkdir -p "$state_dir"
printf '%q ' "$@" >>"$state_dir/railway.log"
printf '\n' >>"$state_dir/railway.log"

service_list() {
  local managed='{"id":"s-managed","name":"vmbox-alpha","status":"SUCCESS","regions":[{"name":"us-east4-eqdc4a"}],"volumes":[]}'
  local unrelated='{"id":"s-production","name":"production","status":"SUCCESS","regions":[],"volumes":[]}'
  if [[ -e "$state_dir/service-deleted" ]]; then
    printf '[%s]\n' "$unrelated"
  else
    printf '[%s,%s]\n' "$managed" "$unrelated"
  fi
}

volume_list() {
  local status=Ready count=0
  if [[ "${VMBOX_TEST_PENDING_VOLUME:-0}" == 1 ]]; then
    [[ -r "$state_dir/volume-list-count" ]] && count="$(<"$state_dir/volume-list-count")"
    count=$((count + 1))
    printf '%s' "$count" >"$state_dir/volume-list-count"
    ((count >= 2)) || status=Creating
  fi
  if [[ -e "$state_dir/volume-deleted" ]]; then
    printf '{"volumes":[{"id":"v-production","name":"prod-data","serviceName":"production","mountPath":"/data","status":"Ready"}]}\n'
  else
    printf '{"volumes":[{"id":"v-managed","name":"box-data","serviceName":"vmbox-alpha","mountPath":"/data","status":"%s","currentSizeMB":12},{"id":"v-production","name":"prod-data","serviceName":"production","mountPath":"/data","status":"Ready"}]}\n' "$status"
  fi
}

case "${1:-} ${2:-}" in
  "--version ") printf 'railway 4.0.0\n' ;;
  "upgrade --yes") ;;
  "usage projects") ;;
  "service list") service_list ;;
  "service delete")
    if [[ "${VMBOX_TEST_FAIL_SERVICE_DELETE:-0}" == 1 ]]; then
      printf 'simulated service deletion failure\n' >&2
      exit 1
    fi
    : >"$state_dir/service-deleted"
    ;;
  "volume "*)
    operation=""
    for argument in "$@"; do
      [[ "$argument" == list || "$argument" == delete ]] && operation="$argument"
    done
    case "$operation" in
      list) volume_list ;;
      delete) : >"$state_dir/volume-deleted" ;;
      *) exit 64 ;;
    esac
    ;;
  "deployment list")
    if [[ -e "$state_dir/deployment-removed" ]]; then
      printf '[{"id":"deployment-old","status":"REMOVED"}]\n'
    elif [[ -e "$state_dir/new-deployment" ]]; then
      printf '[{"id":"deployment-new","status":"INITIALIZING"}]\n'
    else
      printf '[{"id":"deployment-old","status":"SUCCESS"}]\n'
    fi
    ;;
  "up "*)
    : >"$state_dir/new-deployment"
    printf '{}\n'
    [[ "${VMBOX_TEST_UP_FAIL_AFTER_SUBMIT:-0}" == 0 ]]
    ;;
  "down "*)
    : >"$state_dir/deployment-removed"
    [[ "${VMBOX_TEST_DOWN_FAIL_AFTER_REMOVE:-0}" == 0 ]]
    ;;
  *)
    printf 'unexpected railway invocation:' >&2
    printf ' %q' "$@" >&2
    printf '\n' >&2
    exit 64
    ;;
esac
