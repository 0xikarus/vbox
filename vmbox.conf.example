# Stable Railway target IDs. These are identifiers, not credentials.
VMBOX_PROJECT_ID="c9671604-0a68-47ee-abe8-16c72922d391"
VMBOX_ENVIRONMENT_ID="be38d867-15fd-4174-af7d-89b54c330daa"
VMBOX_SERVICE_PREFIX="vmbox-"
# Set to 1 only while migrating old boxes whose service names lack the prefix.
# VMBOX_ALLOW_LEGACY_SERVICES=1
VMBOX_DEFAULT_REGION="us-east"
# Set to 0 to show cost without asking to delete after tmux disconnects.
# VMBOX_POST_DETACH_PROMPT=0
# Reusable choices are stored with mode 0600 at ~/.config/vmbox/reuse.json.
# VMBOX_REUSE_FILE="/absolute/path/to/reuse.json"

# Optional default shown first in the new-box Markdown picker.
# VMBOX_INSTRUCTIONS_FILE="/absolute/path/to/project-instructions.md"

# Direct Railway SSH is the default data path: the deployment instance is
# resolved once per operation and reused over one OpenSSH ControlMaster.
# Set to 1 to force every remote command through `railway ssh` instead.
# VMBOX_DISABLE_DIRECT_SSH=1
# The vmbox-only known-hosts file. ~/.ssh/known_hosts is never used or changed.
# VMBOX_SSH_KNOWN_HOSTS="/absolute/path/to/railway-known-hosts"
