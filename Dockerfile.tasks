FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/vmbox-factory ./cmd/vmbox-factory \
 && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/vmbox-task-runner ./cmd/vmbox-task-runner

FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates openssh-client \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/ /usr/local/bin/
COPY scripts/tasks-entrypoint.sh /usr/local/bin/tasks-entrypoint
RUN chmod 0755 /usr/local/bin/tasks-entrypoint
ENTRYPOINT ["/usr/local/bin/tasks-entrypoint"]
