FROM --platform=$BUILDPLATFORM golang:1.26-bookworm AS build
ARG TARGETOS TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -o /out/vbox ./cmd/vbox

# Only the trusted host manager has the Docker client/socket. Workloads use the
# separate standalone image and never receive this socket or hub credentials.
FROM docker:29-cli
COPY --from=build /out/vbox /usr/local/bin/vbox
ENTRYPOINT []
CMD ["vbox", "hub", "serve"]
